{
  "name": "@flun/webauthn-server",
  "version": "2.1.4",
  "description": "这是一个专为 Node.js 环境设计的 WebAuthn（含 Passkeys）服务端工具库,提供简洁的 TypeScript 实现,并内置对证书、密钥及 CBOR 编码的完整处理能力,适用于构建 FIDO2/Passkey 身份验证后端",
  "keywords": [
    "typescript",
    "webauthn",
    "passkeys",
    "fido",
    "node"
  ],
  "type": "module",
  "types": "index.d.ts",
  "main": "index.js",
  "module": "./index.js",
  "exports": {
    ".": "./index.js",
    "./helpers": "./helpers/index.js"
  },
  "scripts": {
    "postinstall": "electron-rebuild -f -w passport-desktop-win32-x64-msvc passport-desktop-win32-ia32-msvc || echo 'Skipping rebuild'"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "helpers/",
    "authentication/",
    "metadata/",
    "registration/",
    "types/",
    "CHANGELOG.md",
    "README.md",
    "LICENSE.md"
  ],
  "author": "flun <open@flun.top>",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFlun/webauthn-server.git"
  },
  "homepage": "https://www.npmjs.com/package/@flun/webauthn-server#readme",
  "bugs": {
    "url": "https://github.com/OpenFlun/webauthn-server/issues"
  },
  "license": "ISC",
  "dependencies": {
    "@hexagon/base64": "^2.0.4",
    "@levischuck/tiny-cbor": "^0.3.6",
    "@peculiar/asn1-android": "^2.8.0",
    "@peculiar/asn1-ecc": "^2.8.0",
    "@peculiar/asn1-rsa": "^2.8.0",
    "@peculiar/asn1-schema": "^2.8.0",
    "@peculiar/asn1-x509": "^2.8.0",
    "@peculiar/x509": "^2.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  },
  "optionalDependencies": {
    "passport-desktop-win32-x64-msvc": "0.1.2",
    "passport-desktop-win32-ia32-msvc": "0.1.2"
  }
}